# copy to .env
# Free key from https://aistudio.google.com/apikey. Without it only the rule checks run.
GEMINI_API_KEY=
# Flash-Lite has a much larger free daily quota than Flash
GEMINI_MODEL=gemini-3.5-flash-lite
# AI requests per IP and hour, protects the free quota
AI_RATE_LIMIT_PER_HOUR=30
# number of proxies in front of the app (0 locally, 1 on Render)
TRUST_PROXY_HOPS=0
